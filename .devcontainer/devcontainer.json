{
    "name": "C",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "postCreateCommand": "curl -fsSL https://codecrafters.io/install.sh | bash && git ls-files '*.c' '*.h' | xargs -r clang-format -i",
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "zsh"
            },
            "extensions": [
                "ms-vsliveshare.vsliveshare",
                "eamodio.gitlens",
                "llvm-vs-code-extensions.vscode-clangd",
                "vadimcn.vscode-lldb"
            ]
        }
    }
}